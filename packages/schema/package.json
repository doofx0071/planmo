{
  "name": "@planmo/schema",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "PlanMo canonical project model, state, and artifact schemas (implemented in Phase 02).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
