{
  "name": "@planmo/schema",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "description": "PlanMo canonical project model, state, and artifact schemas (versioned, Zod-validated).",
  "license": "MIT",
  "keywords": [
    "planmo",
    "schema",
    "zod",
    "validation",
    "project-model"
  ],
  "homepage": "https://github.com/doofx0071/planmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doofx0071/planmo.git",
    "directory": "packages/schema"
  },
  "bugs": {
    "url": "https://github.com/doofx0071/planmo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/shared": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
