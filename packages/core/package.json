{
  "name": "@planmo/core",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "PlanMo deterministic core: canonical project model, safe filesystem writer, planning compiler.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/schema": "workspace:*",
    "@planmo/shared": "workspace:*",
    "yaml": "2.9.1"
  }
}
