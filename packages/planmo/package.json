{
  "name": "planmo",
  "version": "1.0.0",
  "description": "PlanMo — CLI-first, agent-native project planning and execution workspace generator.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "planmo": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/core": "workspace:*",
    "@planmo/scanner": "workspace:*",
    "@planmo/schema": "workspace:*",
    "@planmo/shared": "workspace:*"
  }
}
