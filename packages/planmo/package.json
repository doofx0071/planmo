{
  "name": "planmo",
  "version": "1.14.1",
  "description": "PlanMo — CLI-first, agent-native project planning and execution workspace generator.",
  "license": "MIT",
  "keywords": [
    "planmo",
    "cli",
    "ai-agents",
    "agent-native",
    "project-planning",
    "scaffolding",
    "agents-md",
    "developer-tools"
  ],
  "homepage": "https://github.com/doofx0071/planmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doofx0071/planmo.git",
    "directory": "packages/planmo"
  },
  "bugs": {
    "url": "https://github.com/doofx0071/planmo/issues"
  },
  "type": "module",
  "bin": {
    "planmo": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@planmo/adapters": "workspace:*",
    "@planmo/agent-bridge": "workspace:*",
    "@planmo/core": "workspace:*",
    "@planmo/ai": "workspace:*",
    "@planmo/generator": "workspace:*",
    "@planmo/packs": "workspace:*",
    "@planmo/scanner": "workspace:*",
    "@planmo/schema": "workspace:*",
    "@planmo/shared": "workspace:*",
    "@planmo/trace": "workspace:*",
    "@planmo/workflow": "workspace:*",
    "yaml": "2.9.1"
  }
}
