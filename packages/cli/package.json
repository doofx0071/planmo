{
  "name": "@planmo/cli",
  "version": "0.0.0",
  "private": true,
  "description": "PlanMo CLI entry point (smoke commands only until Phase 03 CLI foundation).",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "planmo": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/core": "workspace:*",
    "@planmo/scanner": "workspace:*",
    "@planmo/schema": "workspace:*",
    "@planmo/shared": "workspace:*"
  }
}
