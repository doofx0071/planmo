{
  "name": "@planmo/packs",
  "version": "1.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "PlanMo declarative pack system: loader, deterministic resolution, lockfile, planning-depth profiles (Phase 04).",
  "license": "MIT",
  "keywords": [
    "planmo",
    "packs",
    "plugins",
    "declarative",
    "standards"
  ],
  "homepage": "https://github.com/doofx0071/planmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doofx0071/planmo.git",
    "directory": "packages/packs"
  },
  "bugs": {
    "url": "https://github.com/doofx0071/planmo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/schema": "workspace:*",
    "@planmo/shared": "workspace:*",
    "yaml": "2.9.1"
  }
}
