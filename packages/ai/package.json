{
  "name": "@planmo/ai",
  "version": "1.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "PlanMo AI layer: a vendor-neutral model-provider abstraction with a deterministic offline mock provider and an OpenAI-compatible HTTP provider (no vendor SDK).",
  "license": "MIT",
  "keywords": [
    "planmo",
    "ai",
    "llm",
    "model-provider",
    "structured-output"
  ],
  "homepage": "https://github.com/doofx0071/planmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doofx0071/planmo.git",
    "directory": "packages/ai"
  },
  "bugs": {
    "url": "https://github.com/doofx0071/planmo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
