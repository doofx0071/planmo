{
  "name": "@planmo/generator",
  "version": "1.1.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "PlanMo planning compiler and artifact generator: canonical IR, renderers, generation manifest, synth preview (Phase 05).",
  "license": "MIT",
  "keywords": [
    "planmo",
    "generator",
    "planning-compiler",
    "scaffolding",
    "deterministic"
  ],
  "homepage": "https://github.com/doofx0071/planmo#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doofx0071/planmo.git",
    "directory": "packages/generator"
  },
  "bugs": {
    "url": "https://github.com/doofx0071/planmo/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@planmo/core": "workspace:*",
    "@planmo/packs": "workspace:*",
    "@planmo/schema": "workspace:*",
    "@planmo/shared": "workspace:*"
  }
}
